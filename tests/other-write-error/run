#!/bin/sh

# SPDX-FileCopyrightText: 2026 AutoTrace contributors
#
# SPDX-License-Identifier: CC0-1.0

# A write that fails, here to a full disk, must make autotrace fail with a
# message.  It used to exit with status 0 (#345).  Needs /dev/full, which
# Linux and FreeBSD have.

. "`dirname "$0"`/../functions"

DIR=$1

test -c /dev/full || skip "no /dev/full"
# MSYS2's shell has /dev/full, but a native autotrace.exe would create a
# plain file of that name instead.
case `uname -s` in
MINGW* | MSYS* | CYGWIN*) skip "/dev/full is the shell's, not the program's" ;;
esac

autotrace -output-format svg -output-file /dev/full $DIR/../other-gerror/input.png \
    > /dev/null 2> $DIR/err.log
RESULT=$?

if [ $RESULT -ne 0 ] && [ -s $DIR/err.log ]; then
    rm -f $DIR/err.log
    ok
else
    fail "exit $RESULT, message: `cat $DIR/err.log`"
fi
