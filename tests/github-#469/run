#!/bin/sh

# SPDX-FileCopyrightText: 2026 AutoTrace contributors
#
# SPDX-License-Identifier: CC0-1.0

# -centerline -corner-surround 0 must not make the first point of an open
# line a corner twice.  The curve between the two had a single point, which
# -keep-knees left unfitted with "Tried to fit curve with less than two
# points", and which otherwise became a segment of zero length (issue #469).
#
# noise.png is 12x12 black and white noise, the same as in github-#468.
# Made with
#   magick -size 12x12 xc:gray50 -seed 8 +noise Impulse -threshold 50% \
#     -type bilevel -strip noise.png
# The file is kept as it is: another ImageMagick may draw other noise.

. "`dirname "$0"`/../functions"

DIR=$1

err=`autotrace -centerline -keep-knees -corner-surround 0 -output-format svg \
    -output-file $DIR/noise.svg $DIR/noise.png 2>&1` ||
    fail "cannot trace noise.png: $err"
rm -f $DIR/noise.svg

case "$err" in
*"less than two points"*) fail "a curve of one point: $err" ;;
esac

# Without -keep-knees, the curve of one point became a line of zero length.
autotrace -centerline -corner-surround 0 -output-format svg \
    -output-file $DIR/noise.svg $DIR/noise.png || fail "cannot trace noise.png"
zero=`awk '{
    gsub(/[MLCz"]/, "\n&")
    k = split($0, s, "\n")
    for (j = 1; j <= k; j++) {
        c = substr(s[j], 1, 1); p = substr(s[j], 2)
        if (c == "L" && p == last) n++
        last = (c == "M" || c == "L") ? p : ""
    }
} END { print n + 0 }' $DIR/noise.svg`
rm -f $DIR/noise.svg
test "$zero" = 0 || fail "$zero segments of zero length"
ok
