#!/bin/sh

# SPDX-FileCopyrightText: © 2026 Peter Lemenkov
#
# SPDX-License-Identifier: CC0-1.0

# The GF (TeX generic font) reader is the only input module that no other
# library provides, and it had no test.  shapes.600gf is generated from
# shapes.mf (see there) and holds two glyphs: A is a square, B a triangle.

. "`dirname "$0"`/../functions"

DIR=$1

failed=""
# SVG checks the traced outline; UGS also checks the font metrics that the
# GF reader hands to the UGS writer (design size, escapement, bearings).
for code in 65 66; do
    for fmt in svg ugs; do
        autotrace -input-format gf -charcode $code $DIR/shapes.600gf -output-format $fmt -output-file $DIR/char$code.$fmt
        if ! diff -q -w --strip-trailing-cr $DIR/char$code.output.$fmt $DIR/char$code.$fmt >/dev/null; then
            failed="$failed $code.$fmt"
        fi
        rm -f $DIR/char$code.$fmt
    done
done

# A malformed font must be reported as an error (exit status 1 from the
# fatal-message handler), not terminate the process from inside the library.
# Byte 60 is the first painting command of character 65; 0xFF is no command.
cp $DIR/shapes.600gf $DIR/corrupt.600gf
printf '\377' | dd of=$DIR/corrupt.600gf bs=1 seek=60 conv=notrunc 2>/dev/null
autotrace -input-format gf -charcode 65 $DIR/corrupt.600gf -output-format svg -output-file $DIR/corrupt.svg 2>$DIR/corrupt.err
RESULT=$?
if [ $RESULT -ne 1 ] || ! grep -q "expected paint or skip or new_row" $DIR/corrupt.err; then
    failed="$failed corrupt-font(exit=$RESULT)"
fi
rm -f $DIR/corrupt.600gf $DIR/corrupt.svg $DIR/corrupt.err

# A truncated font has no postamble; it must be rejected the same way, with
# the reason in the message.
head -c 300 $DIR/shapes.600gf > $DIR/truncated.600gf
autotrace -input-format gf -charcode 65 $DIR/truncated.600gf -output-format svg -output-file $DIR/truncated.svg 2>$DIR/truncated.err
RESULT=$?
if [ $RESULT -ne 1 ] || ! grep -q "invalid signature" $DIR/truncated.err || grep -q "Cannot open input GF file" $DIR/truncated.err; then
    failed="$failed truncated-font(exit=$RESULT)"
fi
rm -f $DIR/truncated.600gf $DIR/truncated.svg $DIR/truncated.err

# Painting or moving outside the character's bounding box must be rejected:
# the bitmap is allocated for that box, and the reader used to write past it
# (GHSA-4cx5-xpv3-hqq5).  Character 65 starts at byte 35 with boc1 (an
# 83x83 box); bytes 41-43 are "paint 0, paint1 83" (a full first row) and
# byte 44 is new_row_0.
# expect_box_error NAME MESSAGE OFFSET BYTES...
expect_box_error() {
    name=$1
    message=$2
    offset=$3
    shift 3
    cp $DIR/shapes.600gf $DIR/$name.600gf
    for b in "$@"; do
        printf "\\`printf '%03o' $b`" | dd of=$DIR/$name.600gf bs=1 seek=$offset conv=notrunc 2>/dev/null
        offset=`expr $offset + 1`
    done
    autotrace -input-format gf -charcode 65 $DIR/$name.600gf -output-format svg -output-file $DIR/$name.svg 2>$DIR/$name.err
    RESULT=$?
    if [ $RESULT -ne 1 ] || ! grep -q "$message" $DIR/$name.err; then
        failed="$failed $name(exit=$RESULT)"
    fi
    rm -f $DIR/$name.600gf $DIR/$name.svg $DIR/$name.err
}
# The first row paints 84 pixels instead of 83.
expect_box_error long-paint "paints outside its bounding box" 43 84
# skip1 200 moves 201 rows down, past the bottom of the box.
expect_box_error long-skip "skips past its bounding box" 44 71 200

# A blank glyph, such as a space, has no pixels but is no error: it traces
# to an empty contour with the glyph's metrics.  blank.600gf (from
# blank.mf) starts with one, so it is also what's traced without -charcode.
# It must not be mistaken for a failed read (#414).
for args in "-charcode 32" ""; do
    autotrace -input-format gf $args $DIR/blank.600gf -output-format ugs -output-file $DIR/blank.ugs 2>$DIR/blank.err
    RESULT=$?
    if [ $RESULT -ne 0 ] || ! diff -q -w --strip-trailing-cr $DIR/char32.output.ugs $DIR/blank.ugs >/dev/null; then
        failed="$failed blank-glyph[$args](exit=$RESULT)"
    fi
    rm -f $DIR/blank.ugs $DIR/blank.err
done

if [ -n "$failed" ]; then
    fail "unexpected output for:$failed"
fi
ok
