#: ../src/autotrace.h:104
msgid ""
"background-color <hexadezimal>: the color of the background that should be "
"ignored, for example FFFFFF; default is no background color."
msgstr ""
"background-color <hexadezimal>: il colore dello sfondo da ignorare, ad "
"esempio FFFFFF; l'impostazione predefinita non prevede alcun colore di "
"sfondo."

#: ../src/autotrace.h:110
msgid ""
"charcode <unsigned>: code of character to load from GF file, allowed are "
"0..255; default is the first character in font."
msgstr ""
"charcode <unsigned>: codice del carattere da caricare dal file GF, sono "
"ammessi 0..255; il valore predefinito è il primo carattere del font."

#: ../src/autotrace.h:115
msgid ""
"color-count <unsigned>: number of colors a color bitmap is reduced to, it "
"does not work on grayscale, allowed are 1..256; default is 0, that means not "
"color reduction is done."
msgstr ""
"color-count <unsigned>: numero di colori a cui viene ridotta una bitmap a "
"colori, non funziona in scala di grigi, sono consentiti 1..256; il valore "
"predefinito è 0, ciò significa che non viene eseguita la riduzione del "
"colore."

#: ../src/autotrace.h:121
msgid ""
"corner-always-threshold <angle-in-degrees>: if the angle at a pixel is less "
"than this, it is considered a corner, even if it is within `corner-surround' "
"pixels of another corner; default is 60. "
msgstr ""
"corner-always-threshold <angolo in gradi>: se l'angolo di un pixel è "
"inferiore a questo, è considerato un'angolo, anche se si trova all'interno "
"dei pixel \"corner-surround\" di un'altro angolo; il valore predefinito è "
"60. "

#: ../src/autotrace.h:127
msgid ""
"corner-surround <unsigned>: number of pixels on either side of a point to "
"consider when determining if that point is a corner; default is 4. "
msgstr ""
"corner-surround <unsigned>: numero di pixel su entrambi i lati di un punto "
"da considerare per determinare se quel punto è un'angolo; il valore "
"predefinito è 4. "

#: ../src/autotrace.h:133
msgid ""
"corner-threshold <angle-in-degrees>: if a pixel, its predecessor(s), and its "
"successor(s) meet at an angle smaller than this, it's a corner; default is "
"100. "
msgstr ""
"corner-threshold <angolo in gradi>: se un pixel, i suoi predecessori e i "
"suoi successori si incontrano con un'angolo inferiore a questo, è un'angolo; "
"il valore predefinito è 100. "

#: ../src/autotrace.h:139
msgid ""
"error-threshold <real>: subdivide fitted curves that are off by more pixels "
"than this; default is 2.0. "
msgstr ""
"error-threshold <reale>: suddivide le curve adattate che sono fuori da un "
"numero di pixel superiore a questo; il valore predefinito è 2.0. "

#: ../src/autotrace.h:144
msgid ""
"filter-iterations <unsigned>: smooth the curve this many times before "
"fitting; default is 4."
msgstr ""
"filter-iterations <unsigned>: leviga la curva così tante volte prima di "
"adattarla; il valore predefinito è 4."

#: ../src/autotrace.h:149
msgid ""
"line-reversion-threshold <real>: if a spline is closer to a straight line "
"than this, weighted by the square of the curve length, keep it a straight "
"line even if it is a list with curves; default is .01. "
msgstr ""
"line-reversion-threshold <reale>: se una spline è più vicina a una linea "
"retta di questa, pesata per il quadrato della lunghezza della curva, la "
"mantiene come una linea retta anche se è una lista con curve; il valore "
"predefinito è .01. "

#: ../src/autotrace.h:155
msgid ""
"line-threshold <real>: if the spline is not more than this far away from the "
"straight line defined by its endpoints,then output a straight line; default "
"is 1. "
msgstr ""
"line-threshold <reale>: se la spline non è più di questa distanza dalla "
"linea retta definita dai suoi punti finali, genera una linea retta; il "
"valore predefinito è 1. "

#: ../src/autotrace.h:161
msgid ""
"remove-adjacent-corners: remove corners that are adjacent; default doesn't "
"remove."
msgstr ""
"remove-adjacent-corners: rimuove gli angoli adiacenti; l'impostazione "
"predefinita non rimuove."

#: ../src/autotrace.h:166
msgid ""
"tangent-surround <unsigned>: number of points on either side of a point to "
"consider when computing the tangent at that point;  default is 3."
msgstr ""
"remove-adjacent-cornerstangent-surround <unsigned>: numero di punti su "
"entrambi i lati di un punto da considerare quando si calcola la tangente in "
"quel punto;  il valore predefinito è 3."

#: ../src/autotrace.h:171
msgid "despeckle-level <unsigned>: 0..20; default is no despeckling. "
msgstr "despeckle-level <unsigned>: 0..20; la norma non rimuove i puntini. "

#: ../src/autotrace.h:174
msgid "despeckle-tightness <real>: 0.0..8.0; default is 2.0. "
msgstr "despeckle-tightness <reale>: 0.0..8.0; la norma è 2.0. "

#: ../src/autotrace.h:177
msgid "noise-removal <real>: 1.0..0.0; default is 0.99. "
msgstr "noise-removal <reale>: 1.0..0.0; la norma è 0.99. "

#: ../src/autotrace.h:181
msgid "centerline: trace a character's centerline, rather than its outline. "
msgstr ""
"centerline: traccia la linea centrale di un carattere, anziché il suo "
"contorno. "

#: ../src/autotrace.h:185
msgid ""
"preserve-width: whether to preserve linewith with centerline fitting; "
"default doesn't preserve."
msgstr ""
"preserve-width: se preservare la linea con l'adattamento della linea "
"centrale; l'impostazione predefinita non preserva."

#: ../src/autotrace.h:190
msgid "width-weight-factor <real>: weight factor for fitting the linewidth."
msgstr ""
"width-weight-factor <reale>: fattore di peso per adattare la larghezza di "
"linea."

