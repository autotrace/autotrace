#: ../src/autotrace.h:104
msgid ""
"background-color <hexadezimal>: the color of the background that should be "
"ignored, for example FFFFFF; default is no background color."
msgstr ""
"color de fondo <hexadedezimal>: el color del fondo que sería ignorado, por "
"ejemplo FFFFFF; or defecto no es color de fondo."

#: ../src/autotrace.h:110
msgid ""
"charcode <unsigned>: code of character to load from GF file, allowed are "
"0..255; default is the first character in font."
msgstr ""
"charcode <unsigned>: código de carácter para cargar desde archivo GF, "
"concedido desde 0..255; por defecto es el primer carácter de la tipografía."

#: ../src/autotrace.h:115
msgid ""
"color-count <unsigned>: number of colors a color bitmap is reduced to, it "
"does not work on grayscale, allowed are 1..256; default is 0, that means not "
"color reduction is done."
msgstr ""
"color-count <unsigned>: número de colores al que un color bitmap es "
"reducido, no funciona en escala de grises, lo concedido es 1..255; por "
"defecto es 0, lo que significa que no se ha hecho ninguna reducción del "
"color."

#: ../src/autotrace.h:121
msgid ""
"corner-always-threshold <angle-in-degrees>: if the angle at a pixel is less "
"than this, it is considered a corner, even if it is within `corner-surround' "
"pixels of another corner; default is 60. "
msgstr ""
"corner-always-threshold <ángulo‐en‐grados>: si el ángulo en un pixel es "
"menor que este, está considerado una esquina, incluso si está dentro de "
"píxeles `corner-surround' de otra esquina; por defecto es 60. "

#: ../src/autotrace.h:127
msgid ""
"corner-surround <unsigned>: number of pixels on either side of a point to "
"consider when determining if that point is a corner; default is 4. "
msgstr ""
"corner-surround <unsigned>: número de píxeles a cada lado de un punto que se "
"deben tener en cuenta para determinar si ese punto es una esquina; el valor "
"predeterminado es 4. "

#: ../src/autotrace.h:133
msgid ""
"corner-threshold <angle-in-degrees>: if a pixel, its predecessor(s), and its "
"successor(s) meet at an angle smaller than this, it's a corner; default is "
"100. "
msgstr ""
"corner-threshold <ángulo‐en‐grados>: si un píxel, su(s) predecesor(es) y su"
"(s) sucesor(es) se encuentran en un ángulo menor que este, es una esquina; "
"el valor predeterminado es 100. "

#: ../src/autotrace.h:139
msgid ""
"error-threshold <real>: subdivide fitted curves that are off by more pixels "
"than this; default is 2.0. "
msgstr ""
"error-threshold <real>: subdivide las curvas ajustadas que estén desviadas "
"por más píxeles que esto; el valor predeterminado es 2.0. "

#: ../src/autotrace.h:144
msgid ""
"filter-iterations <unsigned>: smooth the curve this many times before "
"fitting; default is 4."
msgstr ""
"filter-iterations <unsigned>: suaviza la curva esta cantidad de veces antes "
"de ajustarla; el valor predeterminado es 4."

#: ../src/autotrace.h:149
msgid ""
"line-reversion-threshold <real>: if a spline is closer to a straight line "
"than this, weighted by the square of the curve length, keep it a straight "
"line even if it is a list with curves; default is .01. "
msgstr ""
"line-reversion-threshold <real>: si una curva está más cerca de una línea "
"recta que esto, ponderada por el cuadrado de la longitud de la curva, "
"manténgala como una línea recta incluso si es una lista con curvas; el valor "
"predeterminado es .01. "

#: ../src/autotrace.h:155
msgid ""
"line-threshold <real>: if the spline is not more than this far away from the "
"straight line defined by its endpoints,then output a straight line; default "
"is 1. "
msgstr ""
"line-threshold <real>: si la curva no está más lejos de esta distancia de la "
"línea recta definida por sus puntos finales, entonces se generará una línea "
"recta; el valor predeterminado es 1. "

#: ../src/autotrace.h:161
msgid ""
"remove-adjacent-corners: remove corners that are adjacent; default doesn't "
"remove."
msgstr ""
"remove-adjacent-corners: eliminar las esquinas que sean adyacentes; por "
"defecto no se eliminan."

#: ../src/autotrace.h:166
msgid ""
"tangent-surround <unsigned>: number of points on either side of a point to "
"consider when computing the tangent at that point;  default is 3."
msgstr ""
"tangent-surround <unsigned>: número de puntos a cada lado de un punto que se "
"deben considerar al calcular la tangente en ese punto; el valor "
"predeterminado es 3."

#: ../src/autotrace.h:171
msgid "despeckle-level <unsigned>: 0..20; default is no despeckling. "
msgstr ""
"despeckle-level <unsigned>: 0..20; por defecto no está eliminando motas. "

#: ../src/autotrace.h:174
msgid "despeckle-tightness <real>: 0.0..8.0; default is 2.0. "
msgstr "despeckle-tightness <real>: 0.0..8.0; por defecto es 2.0. "

#: ../src/autotrace.h:177
msgid "noise-removal <real>: 1.0..0.0; default is 0.99. "
msgstr "noise-removal <real>: 1.0..0.0; por defecto es 0.99. "

#: ../src/autotrace.h:181
msgid "centerline: trace a character's centerline, rather than its outline. "
msgstr ""
"centerline: traza la línea central de un personaje, en lugar de su contorno. "

#: ../src/autotrace.h:185
msgid ""
"preserve-width: whether to preserve linewith with centerline fitting; "
"default doesn't preserve."
msgstr ""
"preserve‐width: si se debe conservar el ancho de línea con el ajuste de la "
"línea central; por defecto no se conserva."

#: ../src/autotrace.h:190
msgid "width-weight-factor <real>: weight factor for fitting the linewidth."
msgstr ""
"width-weight-factor <real>: factor de ponderación para ajustar el ancho de "
"línea."

